# 字节码缓存
__pycache__/
*.pyc
*.pyo

# 测试 / 分析产生的临时产物
*.json.tmp
mc_flow_*.json
eval_ai_fix_report.json

# 临时备份 / 冲突残留（R241 踩过：变异测试留下的 package.json.bak 被
# `git add -A` 一起提交了。备份文件只在验证期间存在，不该进历史）
*.bak
*.orig
*.rej
*.swp

# 分析器 / 打包链产物（原先只在归档文档里「声称已落地」，实际缺失；
# 多次分析或打包后会把整棵树污染进 git status —— 现在真正落地）
.analyzer_*
.codebuddy/
dist_bin/
_build/
*.sarif
*.git.patch
watch_status.json

# MCP 工具默认落盘位置（matlabc_mcp.py 锁定 CWD + basename 防穿越）
mcp_analysis.md
mcp_fix.patch*

# --browse 的默认输出目录（省略 OUTDIR 时使用，见 matlabc.py 的 --browse）
matlabc_browse/
tests/_t_*/
tests/_t_xf_out/

# 会话 / 自动化的工作目录（WorkBuddy 在**当前工作目录**下建它；
# 仓库里出现时只是噪声：不是项目产物，且会随会话漂移。
# 依据：git status 显示 `?? .workbuddy/`、git ls-files 为 0 条。）
.workbuddy/

# 操作系统
.DS_Store
Thumbs.db

# archify 交付产物（大 HTML + 浏览器证据侧车，不入库）
.archify/**
# **图的源要入库**（R1033）：`candidate.json` 是手写的图定义，不入库则换台机器
# 图就没了，review 里也看不到它改了什么。被忽略的只是渲染产物与证据侧车
# （每个 ~800KB）。
#
# 注意：Git 不允许用 `!` 重新包含**已被忽略目录内部**的文件，所以这里
# **不能**写 `!.archify/**/candidate.json`（实测无效）。新增图时用：
#     git add -f .archify/<dir>/candidate.json

.debt_trend.json
.matlabc_cache.pkl
.matlabc_lsp_cache.json

# py36 门禁的本地增量缓存（可随时删，删了重算）
releases/.py36-cache.json
releases/.gate-cache.json
releases/.help-output-cache.json

# Rust 构建产物
rust/*/target/

# 门写下的结构化统计（每次发版覆盖，属于产物不属于源码）
releases/.gate-stats/
translate/examples/build/
translate/examples/.m2c/

# 运行日志与任务历史（R858 补）——
# *.log：matlabc_task 曾把失败日志写到模块旁，留下未跟踪文件；
# .matlabc/：任务记录与日志现在写在**被操作的项目内**，属于产物。
*.log
.matlabc/

# 大脑上行请求的中间快照（R1056）——每次 ask 生成一个 req-*.txt，
# 属运行产物；SYSTEM.md 是协议配置，仍入库。
flow/llm-io/req-*.txt
.playwright-cli/
