  "cards": [
    {
      "dot": "cyan",
      "title": "行锚点不可丢",
      "items": [
        "注释/字符串替换为空格但保留换行：后续行号与源码一致",
        "body_end 缺失会让大纲 Range 越界，编辑器拒收整批符号"
      ]
    },
    {
      "dot": "amber",
      "title": "两种函数风格",
      "items": [
        "显式 end 风格：按 end 配对关闭",
        "旧式平级局部函数：由下一个 function 隐式关闭上一个"
      ]
    },
    {
      "dot": "rose",
      "title": "唯一判定点",
      "items": [
        "MATLAB 的 unresolved 只由 frontends/matlab.py 产出",
        "IR_LANG_OWNERS 登记谁负责判定，check_ir_attribution 双向核对"
      ]
    }
