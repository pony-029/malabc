  "cards": [
    {
      "dot": "emerald",
      "title": "三类输入，一份模型",
      "items": [
        "MATLAB / C / Python / JS 与二进制元数据都归到同一套实体与事实",
        "归因判定由 IR_LANG_OWNERS 登记，check_ir_attribution 双向核对",
        "不执行、不反汇编：二进制只读依赖与导出表"
      ]
    },
    {
      "dot": "rose",
      "title": "一份模型，多种分析",
      "items": [
        "调用图 / 影响面 / 依赖 / 污点 / 维度 / 检查共享 build_analysis_model",
        "分析不各自解析源码，避免同一份代码长出多套口径",
        "每条告警都能回到具体文件与行"
      ]
    },
    {
      "dot": "orange",
      "title": "多种消费，同一份事实",
      "items": [
        "报告 / 站点 / JSON / SARIF / LSP / MCP / 补丁都消费同一份分析结果",
        "新增出口只写渲染器，不改分析内核",
        "CI 只认退出码，不认日志里的“看起来成功”"
      ]
    }
  ]
