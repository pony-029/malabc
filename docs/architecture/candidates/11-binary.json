  "cards": [
    {
      "dot": "cyan",
      "title": "不执行、不反汇编",
      "items": [
        "只读头部/段表/导出表/节名，绝不运行二进制",
        "不可解析是一等状态，不猜一个名字"
      ]
    },
    {
      "dot": "amber",
      "title": "三个真实陷阱",
      "items": [
        "PE 段名 8 字节硬截断：.nv_fatbin → .nv_fatb",
        "cubin 不是标准 ELF（e_type=0x8000）",
        "CUDA kernel 名在 .text._Z… 节名表里"
      ]
    },
    {
      "dot": "emerald",
      "title": "跨语言桥接",
      "items": [
        "mex/calllib 让调用链在边界断掉",
        "有导出表就明确 ✓/✗，没有就诚实说 missing"
      ]
    }
  ]
