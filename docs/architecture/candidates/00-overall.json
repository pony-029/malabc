  "cards": [
    {
      "dot": "cyan",
      "title": "一条主干，四种出口",
      "items": [
        "读代码 → 解析 → 模型/分析 → 输出；LSP/MCP/闭环/移植是同一份分析的四种消费方式",
        "单文件内核 matlabc.py 零第三方依赖，3.6.5 即可运行"
      ]
    },
    {
      "dot": "emerald",
      "title": "三套「能证明」的装置",
      "items": [
        "输出侧：--browse 四语言同形站点 + report/JSON/SARIF/Doxygen",
        "编辑器侧：LSP diagnostic/documentSymbol/definition/references",
        "工程侧：39 道 check_*.py + check_all.py + CI 退出码"
      ]
    },
    {
      "dot": "amber",
      "title": "新增的移植链路",
      "items": [
        "translate/ 把 MATLAB 语句确定性映射为算子",
        "c_runtime/ 是 C 落点；port_ledger 记录每个算子的 verified 状态"
      ]
    }
  ]
