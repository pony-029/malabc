  "cards": [
    {
      "dot": "emerald",
      "title": "正常路径",
      "items": [
        "打开文件 → initialize → run_pipeline → documentSymbol → 大纲",
        "服务端一次解析，诊断与大纲共享同一份模型",
        "缓存命中时 documentSymbol 不必重新解析"
      ]
    },
    {
      "dot": "rose",
      "title": "800ms 的边界",
      "items": [
        "客户端对 documentSymbol 设 800ms 超时，不让编辑器无限转圈",
        "超时不是“工具坏了”，而是切到本地兜底路径",
        "兜底结果同样按 %% 分节，形态与服务端一致"
      ]
    },
    {
      "dot": "orange",
      "title": "兜底的诚实",
      "items": [
        "脚本无 function 时按 %% 分节列出",
        "无分节时显示文件名本身，副标题写明原因",
        "绝不返回空白大纲——空白无法与“工具坏了”区分"
      ]
    }
  ]
