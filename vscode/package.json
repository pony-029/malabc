{
  "name": "matlabc",
  "displayName": "matlabc",
  "description": "MATLAB 工程的代码理解工具：结构感知的诊断、跨文件导航、调用链分析与影响面评估。",
  "version": "1.5.7",
  "publisher": "冯磊",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:matlab"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "matlab",
        "aliases": [
          "MATLAB",
          "matlab"
        ],
        "extensions": [
          ".m"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/matlab.svg",
          "dark": "./icons/matlab.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "matlab",
        "scopeName": "source.matlab",
        "path": "./syntaxes/matlab.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "matlabc",
      "properties": {
        "matlabc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 matlabc 的 MATLAB 诊断与跳转"
        },
        "matlabc.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python 解释器路径。默认 python（从系统 PATH 查找）。提示找不到 Python 时，用命令「matlabc: 选择 Python 解释器」挑选，或在这里填绝对路径，例如 C:\\\\Python310\\\\python.exe"
        },
        "matlabc.docLang": {
          "type": "string",
          "enum": [
            "both",
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "中文在前，同时显示英文（默认）",
            "只显示中文",
            "只显示英文"
          ],
          "default": "both",
          "description": "内置函数悬停说明的语言。只影响 MATLAB 内置函数；你自己定义的函数始终显示其头部注释原文。"
        },
        "matlabc.lspPath": {
          "type": "string",
          "default": "",
          "description": "matlabc_lsp.py 的绝对路径；留空则用当前工作区的 ../matlabc_lsp.py"
        },
        "matlabc.crossLanguage": {
          "type": "boolean",
          "default": true,
          "description": "跨语言分析：扫描工程内的 C/C++ 源与 mex/DLL 导出表，把 MATLAB 里解析不到的调用接到它们的实现上。关闭后不再扫描这些文件（大工程可省 IO）。"
        },
        "matlabc.undoDiffLimit": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 40,
          "description": "撤销前最多打开几个并排 diff（文件很多时限制标签页数量）"
        },
        "matlabc.slowTaskFactor": {
          "type": "number",
          "default": 2,
          "minimum": 1.1,
          "maximum": 10,
          "description": "改动记录里「偏慢」的倍率：超过同类任务耗时中位数的这个倍数才标"
        },
        "matlabc.slowTaskMinMs": {
          "type": "integer",
          "default": 200,
          "minimum": 0,
          "maximum": 60000,
          "description": "「偏慢」的绝对下限（毫秒）—— 太短的任务不该被标"
        }
      }
    },
    "commands": [
      {
        "command": "matlabc.previewGraph",
        "title": "matlabc: 预览调用关系图",
        "category": "matlabc"
      },
      {
        "command": "matlabc.showHeat",
        "title": "matlabc: 热点函数排行",
        "category": "matlabc"
      },
      {
        "command": "matlabc.showHeatHere",
        "title": "matlabc: 热点函数排行（当前目录）",
        "category": "matlabc"
      },
      {
        "command": "matlabc.previewGraphH",
        "title": "matlabc: 预览调用关系图（横向）",
        "category": "matlabc"
      },
      {
        "command": "matlabc.showRelations",
        "title": "matlabc: 查看名字的关系（函数/变量）",
        "category": "matlabc"
      },
      {
        "command": "matlabc.generateReport",
        "title": "matlabc: 生成 HTML 分析报告",
        "category": "matlabc"
      },
      {
        "command": "matlabc.generateMcpConfig",
        "title": "matlabc: 生成 MCP 配置（给 AI 客户端）",
        "category": "matlabc"
      },
      {
        "command": "matlabc.openTour",
        "title": "matlabc: 打开使用导览",
        "category": "matlabc"
      },
      {
        "command": "matlabc.openGuide",
        "title": "matlabc: 打开使用说明",
        "category": "matlabc"
      },
      {
        "command": "matlabc.openGuidePdf",
        "title": "matlabc: 打开使用说明（PDF）",
        "category": "matlabc"
      },
      {
        "command": "matlabc.selectPython",
        "title": "matlabc: 选择 Python 解释器",
        "category": "matlabc"
      },
      {
        "command": "matlabc.undoLastTask",
        "title": "matlabc: 撤销上一次改动",
        "category": "matlabc"
      },
      {
        "command": "matlabc.restartServer",
        "title": "matlabc: 重新启动服务",
        "category": "matlabc"
      },
      {
        "command": "matlabc.generateHtmlReport",
        "title": "matlabc: 生成工程 HTML 报告",
        "category": "matlabc"
      },
      {
        "command": "matlabc.generateSite",
        "title": "matlabc: 生成工程站点（site 级 HTML 文档）",
        "category": "matlabc"
      },
      {
        "command": "matlabc.refreshOutline",
        "title": "matlabc: 重新扫描大纲",
        "category": "matlabc"
      },
      {
        "command": "matlabc.showLog",
        "title": "matlabc: 查看日志",
        "category": "matlabc"
      },
      {
        "command": "matlabc.showRecentCommits",
        "title": "matlabc: 查看最近的提交",
        "category": "matlabc"
      },
      {
        "command": "matlabc.confirmUndo",
        "title": "matlabc: 确认撤销",
        "category": "matlabc"
      },
      {
        "command": "matlabc.undoTaskById",
        "title": "matlabc: 撤销这一次改动",
        "category": "matlabc"
      },
      {
        "command": "matlabc.diffTaskById",
        "title": "matlabc: 查看这一次改了什么",
        "category": "matlabc"
      },
      {
        "command": "matlabc.copyTaskId",
        "title": "matlabc: 复制记录 id",
        "category": "matlabc"
      },
      {
        "command": "matlabc.undoById",
        "title": "matlabc: 按 id 撤销改动",
        "category": "matlabc"
      },
      {
        "command": "matlabc.filterTasks",
        "title": "matlabc: 按文件过滤改动记录",
        "category": "matlabc"
      },
      {
        "command": "matlabc.sortTasksByTime",
        "title": "matlabc: 改动记录按耗时排序",
        "category": "matlabc"
      },
      {
        "command": "matlabc.clearTaskFilter",
        "title": "matlabc: 清除改动记录过滤",
        "category": "matlabc"
      },
      {
        "command": "matlabc.exportLog",
        "title": "matlabc: 导出日志",
        "category": "matlabc"
      },
      {
        "command": "matlabc.openDefinitionOf",
        "title": "matlabc: 跳到定义处",
        "category": "matlabc"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "matlabc.showRelations",
          "when": "editorLangId == matlab",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "matlabc.undoTaskById",
          "when": "view == matlabcTasks && viewItem == taskPending",
          "group": "inline"
        },
        {
          "command": "matlabc.diffTaskById",
          "when": "view == matlabcTasks && viewItem == taskPending",
          "group": "1_view"
        },
        {
          "command": "matlabc.diffTaskById",
          "when": "view == matlabcTasks && viewItem == taskDone",
          "group": "1_view"
        },
        {
          "command": "matlabc.copyTaskId",
          "when": "view == matlabcTasks",
          "group": "2_copy"
        },
        {
          "command": "matlabc.openDefinitionOf",
          "when": "view == matlabcRelations && viewItem == relNode",
          "group": "1_view"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "matlabcRelations",
          "name": "matlabc 关系"
        },
        {
          "id": "matlabcTasks",
          "name": "改动记录",
          "icon": "icon.png"
        }
      ]
    }
  },
  "dependencies": {},
  "author": {
    "name": "冯磊 (Feng Lei)"
  },
  "license": "MIT",
  "copyright": "Copyright © 2026 冯磊 (Feng Lei)",
  "icon": "icon.png"
}
