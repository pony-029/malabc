{
  "name": "matlabc-lsp",
  "displayName": "malabc MATLAB LSP",
  "description": "MATLAB 的编辑器智能：诊断 · 转到定义（含结构体成员）· 查找引用 · 悬停 · 大纲 · 保存即刷新。后台预热、零配置、零 npm 依赖。",
  "version": "0.3.3",
  "publisher": "malabc",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:matlab"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "matlab",
        "aliases": ["MATLAB", "matlab"],
        "extensions": [".m"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/matlab.svg",
          "dark": "./icons/matlab.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "matlab",
        "scopeName": "source.matlab",
        "path": "./syntaxes/matlab.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "malabc",
      "properties": {
        "matlabc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 malabc 的 MATLAB 诊断与跳转"
        },
        "matlabc.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python 解释器路径（需要能跑 matlabc_lsp.py）"
        },
        "matlabc.lspPath": {
          "type": "string",
          "default": "",
          "description": "matlabc_lsp.py 的绝对路径；留空则用当前工作区的 ../matlabc_lsp.py"
        }
      }
    }
  },
  "dependencies": {}
}
