{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MATLAB",
  "scopeName": "source.matlab",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "MATLAB 要求 `%{` / `%}` **独占一行**才算块注释。原来无条件匹配 `%{`，于是 `x=1; %{ 说明` 会开一个块注释并吃掉后面所有代码 —— 这是 R214 修的第二处不一致。",
          "name": "comment.block.percentage.matlab",
          "begin": "^\\s*%\\{\\s*$",
          "end": "^\\s*%\\}\\s*$",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.matlab" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.matlab" } },
          "foreground": "#7A9E5B"
        },
        {
          "comment": "MATLAB 注释占行极多，用一眼可辨的绿色，和关键字/字符串拉开。",
          "name": "comment.line.percentage.matlab",
          "match": "%.*$",
          "captures": { "0": { "name": "punctuation.definition.comment.matlab" } },
          "foreground": "#7A9E5B"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.matlab",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.matlab", "match": "\\\\." }
          ]
        },
        {
          "comment": "`'` 在 MATLAB 里既是字符串定界符也是转置。R214：只有「前面不是标识符/右括号/右方括号/右花括号/点/数字」时才当字符串 —— `X'`、`(A*B)'`、`s.f'` 都是转置，不再开启字符串。之前无条件匹配，一个 `X'` 就能把后面几十行染成字符串色。",
          "name": "string.quoted.single.matlab",
          "begin": "(?<![\\w)\\]}.])'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.matlab", "match": "''" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.matlab",
          "match": "(?<![\\w.])(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?[ij]?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.matlab",
          "match": "\\b(?:if|elseif|else|end|for|parfor|while|switch|case|otherwise|try|catch|return|break|continue|function|classdef|properties|methods|events|enumeration|global|persistent|spmd|import)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "comment": "只保留真正不会歧义的常量。`i` / `j` 常被当循环变量，`end` 是关键字（已在上面的 keyword 规则里），都不能列进来 —— R212 实测：`for i = 1:size(X,1)` 的 i 被染成常量色，和 `X(:,1)` 的索引色并存，看起来就是「同类不一致」。",
          "name": "constant.language.matlab",
          "match": "\\b(?:true|false|pi|Inf|inf|NaN|nan|eps)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.matlab",
          "match": "(?:==|~=|<=|>=|&&|\\|\\||\\.\\*|\\./|\\.\\^|\\.\\\\|[+\\-*/\\\\^<>=&|~:])"
        }
      ]
    }
  }
}
