{
  "version": 2,
  "matlab": {
    "root": "numeric",
    "recursive": true,
    "exclude": []
  },
  "c": {
    "root": "build/gen",
    "project": "numeric_demo",
    "prefix": "m2c_",
    "runtime": "c_runtime"
  },
  "targets": {
    "pc": {
      "abi": "host",
      "allow_heap": true,
      "dtype": "f64"
    },
    "mcu": {
      "abi": "arm",
      "allow_heap": false,
      "dtype": "f32",
      "max_stack_bytes": 2048
    }
  },
  "modules": [
    {
      "id": "accum",
      "targets": ["mcu"],
      "sources": ["colsum_loop", "col2sum"],
      "entry": "colsum_loop",
      "timing": {
        "period_ms": 1,
        "deadline_ms": 0.8,
        "entry_kind": "isr",
        "reentrant": false
      },
      "operators": {
        "sum": "vendor_sum_f32"
      }
    },
    {
      "id": "batch",
      "targets": ["pc"],
      "sources": ["condsize", "countel"],
      "entry": "condsize"
    }
  ],
  "operators": {},
  "constraints": {
    "forbid_heap": ["mcu"]
  }
}
