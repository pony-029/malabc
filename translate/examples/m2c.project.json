{
  "version": 2,
  "matlab": {
    "root": "numeric",
    "recursive": true,
    "exclude": []
  },
  "c": {
    "root": "build/gen",
    "project": "numeric_demo",
    "prefix": "m2c_",
    "runtime": "c_runtime"
  },
  "dtypes": {
    "default": "f64",
    "map": {
      "double": "f64",
      "single": "f32",
      "int32": "int32",
      "int16": "int16",
      "int8": "int8"
    },
    "fixed_point": {
      "format": "Q15",
      "frac_bits": 15,
      "round": "nearest",
      "overflow": "saturate"
    }
  },
  "targets": {
    "pc": {
      "abi": "host",
      "allow_heap": true,
      "dtype": "f64"
    },
    "mcu": {
      "abi": "arm",
      "allow_heap": false,
      "dtype": "f32",
      "max_stack_bytes": 2048,
      "memory": {
        "strategy": "static_pool",
        "pool_bytes": 65536,
        "alignment": 8,
        "max_array_bytes": 8192,
        "arrays": [
          { "name": "accum_buf", "elements": 256, "dtype": "f32" },
          { "name": "accum_tmp", "elements": 64, "dtype": "f32" }
        ]
      }
    }
  },
  "modules": [
    {
      "id": "accum",
      "targets": ["mcu"],
      "sources": ["colsum_loop", "col2sum"],
      "entry": "colsum_loop",
      "timing": {
        "period_ms": 1,
        "deadline_ms": 0.8,
        "entry_kind": "isr",
        "reentrant": false
      },
      "operators": {
        "sum": "vendor_sum_f32"
      }
    },
    {
      "id": "batch",
      "targets": ["pc"],
      "sources": ["condsize", "countel"],
      "entry": "condsize"
    }
  ],
  "operators": {},
  "constraints": {
    "forbid_heap": ["mcu"],
    "no_recursion": true,
    "max_ops_per_entry": 200
  }
}
