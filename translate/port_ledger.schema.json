{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "matlabc port ledger",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "matlab", "c", "status", "operators", "golden"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "matlab": {"type": "string", "minLength": 1},
          "c": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["not_started", "ported_unverified", "verified", "deprecated"]
          },
          "operators": {
            "type": "array",
            "items": {"type": "string"}
          },
          "golden": {
            "type": "array",
            "items": {"type": "string"}
          },
          "owner": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
