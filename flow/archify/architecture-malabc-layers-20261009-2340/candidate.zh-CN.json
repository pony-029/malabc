    {
      "dot": "cyan",
      "title": "内核五层，按顺序",
      "items": [
        "词法 —— scrub_source / _logical_statements 去掉注释与字符串，保留行锚",
        "解析 —— parse_file / analyze_calls / resolve_call 把文本变成调用点",
        "数据 —— MatlabFunction / MatlabClass / MatlabFile 是内存模型",
        "分析 —— 影响、依赖与风险度量、静态检查、污点、重复指纹",
        "渲染 —— render_* 组装 report / browse / json / sarif 输出"
      ]
    },
    {
      "dot": "emerald",
      "title": "为什么是单文件",
      "items": [
        "整个内核就是一个 matlabc.py：无第三方依赖、无需安装",
        "只用 Python 3 标准库，3.6.5 解释器就够"
      ]
    },
    {
      "dot": "amber",
      "title": "五族产物",
