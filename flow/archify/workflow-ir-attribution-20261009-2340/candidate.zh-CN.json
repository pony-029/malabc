  "cards": [
    {
      "dot": "rose",
      "title": "六条变异，各自必须命中一条具名判据",
      "items": [
        "新增一个自带 build_edges 的前端 → I1（写点集合）",
        "保留接线但内联查表 → I5（小写查表指纹）",
        "在归因代码里现算名字 → I4（归因来源必须结构化，来自 AST）",
        "保留接线、内联且不带查表 → I1b（写点形状）",
        "多登记一种语言 → I6 前向（已注册前端必须调共享 token）",
        "把登记指向拼错的函数 → I6 反向（登记项必须解析到真可调用）"
      ]
    },
    {
      "dot": "amber",
      "title": "为什么需要 I1b",
      "items": [
        "只看 I1，它只盯写点集合",
        "「保留共享调用、又顺手内联 append」这种改法对 I1 隐形",
        "首次红路探针证实了这点：该变异被 I5 抓住，于是 I1b 当时没有独立证人 —— 直到补上第四条变异"
      ]
    },
    {
      "dot": "cyan",
      "title": "在这之前：行为保持证明",
      "items": [
        "用 git archive HEAD 导出旧树，同一批命令跑两侧",
        "10 个产物（5 组命令的 JSON + stdout）逐字节比对",
        "探针自身引入的变量遮蔽并计数；本轮声明的差异打印其值；其余一律归红"
      ]
    }
  ]
