  "cards": [
    {
      "dot": "cyan",
      "title": "为什么收成唯一判定点",
      "items": [
        "收拢前：同一条规则被抄了五遍（两处内联构建 + 四个前端 build_edges）",
        "现在：frontends/ir.py 的 resolve_calls(func_index, call_sites) 是唯一判定处",
        "build_ir 是 unresolved 列表的唯一写入点"
      ]
    },
    {
      "dot": "amber",
      "title": "MATLAB 保留自己的模块",
      "items": [
        "MATLAB 按名聚合 external_calls，与 C / Py / JS 的调用点形状不同",
        "frontends/matlab.py · unresolved_tuples() 必须保持旧的插入顺序",
        "改了这个顺序，会静默打乱 Counter.most_common() 的并列次序"
      ]
    },
    {
      "dot": "rose",
      "title": "未解析的名字用来做什么",
      "items": [
        "它供给「可能漏掉」页，绝不静默丢弃",
        "--binary-attach 再把每个名字变成 library: / gpu_kernel: / missing",
        "假阳性比不归因更糟，所以 missing 是一个真答案"
      ]
    }
  ]
}
