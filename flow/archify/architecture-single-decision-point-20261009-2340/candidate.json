  "cards": [
    {
      "dot": "cyan",
      "title": "Why a single decision point",
      "items": [
        "Before: the same rule was copied five times (two inlined builders plus four frontend build_edges)",
        "Now: resolve_calls(func_index, call_sites) in frontends/ir.py is the only place that decides",
        "build_ir is the only writer of the unresolved list"
      ]
    },
    {
      "dot": "amber",
      "title": "MATLAB keeps its own module",
      "items": [
        "MATLAB aggregates external_calls by name, a different shape from the C / Py / JS call sites",
        "frontends/matlab.py · unresolved_tuples() must keep the legacy insertion order",
        "Changing that order would silently reorder Counter.most_common() ties"
      ]
    },
    {
      "dot": "rose",
      "title": "What an unresolved name is for",
      "items": [
        "It feeds the 'possibly missed' page, never a silent drop",
        "--binary-attach then turns each name into library: / gpu_kernel: / missing",
        "A false positive is worse than no attribution, so 'missing' is a real answer"
      ]
    }
  ]
