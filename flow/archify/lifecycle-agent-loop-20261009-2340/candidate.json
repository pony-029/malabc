  "cards": [
    {
      "dot": "cyan",
      "title": "Why this loop is trusted",
      "items": [
        "A patch is never accepted because it was generated — it is accepted because the rescan proves it",
        "Two independent gates: git apply --check before, rescan after",
        "Every rejection returns a structured feedback object the next attempt can read"
      ]
    },
    {
      "dot": "amber",
      "title": "The loop is bounded by design",
      "items": [
        "max_turns caps the attempts; exhaustion is a normal, reported outcome (tier 2)",
        "The exhausted path still emits a checkpoint and an optional Draft PR instead of failing silently",
        "tier 0 means nothing to do, tier 1 means a verified fix, tier 2 means a human is needed"
      ]
    },
    {
      "dot": "rose",
      "title": "No half-applied state",
      "items": [
        "A failed verification is rolled back with git apply -R or an in-process snapshot restore",
        "The review_gate path deliberately leaves the tree clean and exits 3 with a review artifact",
        "A learned fix is only recorded after acceptance"
      ]
    }
  ]
