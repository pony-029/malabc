  "cards": [
    {
      "dot": "cyan",
      "title": "这个闭环为什么可信",
      "items": [
        "补丁从不因为「被生成出来」而被接受 —— 它被接受，是因为重扫证明了它",
        "两道独立闸：前有 git apply --check，后有重扫",
        "每一次拒绝都返回一个结构化反馈对象，下一次尝试能读到"
      ]
    },
    {
      "dot": "amber",
      "title": "闭环在设计上就是有界的",
      "items": [
        "max_turns 给尝试次数封顶；用尽是一个正常、被上报的结论（tier 2）",
        "用尽路径仍然产出检查点与可选 Draft PR，而不是静默失败",
        "tier 0 表示无事可做，tier 1 表示已验证的修复，tier 2 表示需要人"
      ]
    },
    {
      "dot": "rose",
      "title": "不留改了一半的树",
      "items": [
        "验证失败用 git apply -R 或进程内快照还原回滚",
        "review_gate 路径刻意把工作区留干净，并以 exit 3 交出审查产物",
        "只有被接受之后，才记录一条已学修复"
      ]
    }
  ]
