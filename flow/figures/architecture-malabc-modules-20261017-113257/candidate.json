  "cards": [
    {
      "dot": "cyan",
      "title": "三条入口，一个内核",
      "items": [
        "CLI 是唯一真入口；GUI 只是用 build_cli_args 拼参数再起子进程",
        "MCP Server 用 stdio JSON-RPC 接 Agent，每次工具调用起一个 CLI 子进程",
        "AI 层（ask / agent_loop / analyzer_memory）读产物做问答，不参与判定"
      ]
    },
    {
      "dot": "emerald",
      "title": "前端与唯一判定点",
      "items": [
        "MATLAB 前端解析函数/类/脚本，带 arguments 块、结构体字段与全局状态",
        "C 前端是词法 + 括号配平扫描器：定义可见，语义仍是文本级",
        "所有语言的调用都走 frontends/ir.resolve_calls，一处判定",
        "实体经 entity_model 归一，MATLAB/C/Python 三家同形"
      ]
    },
    {
      "dot": "violet",
      "title": "图、库与归因",
      "items": [
        "callrel 把边投影成有界输出，两种身份口径（名字 / 定义落点）并列",
        "unified_graph 只回答图是否守恒：A1a/A1b 站点账 + A4 去重",
        "binfmt 解析容器与内嵌 GPU；resolve_graph 沿依赖逐层下钻",
        "attribute 把未解析名归到 library / gpu_kernel / missing 三态"
      ]
    },
    {
      "dot": "amber",
      "title": "产物、快照与门禁",
      "items": [
        "--json 是报表契约；--from-json 回放、--diff 双快照对比、--fingerprint 防篡改",
        "--sarif 2.1.0 + 退出码 + 基线比对接 CI；--gen-apply-patch 产确定性补丁",
        "--browse 站点服务端算 SVG，零 JS、零 CDN，断网可开",
        "22 个 check_*.py 与 516 个测试守住上述每一条结论"
      ]
    }
  ]
