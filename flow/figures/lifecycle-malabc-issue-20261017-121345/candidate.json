  "cards": [
    {
      "dot": "cyan",
      "title": "每个状态都有证据",
      "items": [
        "告警必须带 rule_id、行号与触发片段",
        "分诊的结论要么是可执行验证，要么是人工判定，不许猜",
        "拒绝也要记账，否则下次还会被人重复踩"
      ]
    },
    {
      "dot": "rose",
      "title": "验证是唯一出口",
      "items": [
        "补丁必须能说出应用前后的差异",
        "行为变坏一律回退，不允许自动合入",
        "当前实现尚未把验证接进沙箱，这是已知缺口"
      ]
    },
    {
      "dot": "amber",
      "title": "基线只许减少",
      "items": [
        "SARIF 基线是棘轮：新增必须解释，减少不用",
        "趋势用来发现缓慢腐烂，而不是阻断单次提交",
        "收束的定义是增量归零，不是数量为零"
      ]
    }
