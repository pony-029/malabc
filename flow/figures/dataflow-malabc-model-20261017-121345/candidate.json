  "cards": [
    {
      "dot": "cyan",
      "title": "两种原料，一次判定",
      "items": [
        "源码侧产出：函数、调用点、include / import",
        "二进制侧产出：依赖、导出符号、内嵌 GPU",
        "两侧只在归因处汇合，不互相重算"
      ]
    },
    {
      "dot": "rose",
      "title": "有界是纪律",
      "items": [
        "内核规模下 706 万条边不可能全量塞进 JSON",
        "投影只给 KB 级，并同时报出 total / shown",
        "被截断的部分不是消失，是明确记账"
      ]
    },
    {
      "dot": "amber",
      "title": "产物只读",
      "items": [
        "JSON 是契约，站点从它派生",
        "--from-json 可离线重放，不再碰源码",
        "产物不反向修改模型，避免二次真相"
      ]
    }
  ]
