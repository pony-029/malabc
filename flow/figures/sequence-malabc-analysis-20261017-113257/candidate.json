  "cards": [
    {
      "dot": "emerald",
      "title": "主链只有一次判定",
      "items": [
        "所有语言的调用都落到 frontends/ir.resolve_calls，一处判定",
        "C 前端只产出候选站点（函数 / 调用 / include），不自己产边",
        "返回消息比请求更轻，避免把主链读成双向"
      ]
    },
    {
      "dot": "rose",
      "title": "二进制归因是可分支",
      "items": [
        "只有给了 --binary / --binary-symbols 才会走到 binfmt",
        "归因只回答三态：library / gpu_kernel / missing",
        "没提供二进制时一律 missing，不假设系统里应该有"
      ]
    },
    {
      "dot": "amber",
      "title": "退出码是合同",
      "items": [
        "分析与渲染分离：站点写盘失败与检查失败是两种退出码",
        "摘要会同时报出截断与未解析的分母",
        "CI 只读退出码 + SARIF，不解析 HTML"
      ]
    }
  ]
