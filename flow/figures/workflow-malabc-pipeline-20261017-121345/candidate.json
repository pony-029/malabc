  "cards": [
    {
      "dot": "cyan",
      "title": "主链只判一次",
      "items": [
        "入口只解析参数，不做语言判断",
        "三种前端产同一种原料：函数、调用点、依赖",
        "调用是否成立只在 resolve_calls 判一次"
      ]
    },
    {
      "dot": "rose",
      "title": "降级必须留痕",
      "items": [
        "ast 被拒而降级到词法时，limitations 必须非空",
        "未解析调用是带名字与行号的清单，不是空集",
        "没提供二进制时有独立 missing 通道，不被静默合并"
      ]
    },
    {
      "dot": "amber",
      "title": "退出码是合同",
      "items": [
        "报告与站点是两种产物，写盘失败与检查失败分开报",
        "CI 只读退出码与 SARIF，不解析 HTML",
        "趋势与基线比对在门禁侧完成，不改分析结果"
      ]
    }
  ]
